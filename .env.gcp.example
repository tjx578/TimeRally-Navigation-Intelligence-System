# Google Cloud deployment template. Copy to .env.gcp and keep the real file local.
PROJECT_ID=timerally-prod
REGION=asia-southeast2
ROUTING_ZONE=asia-southeast2-a

ARTIFACT_REPO=timerally
CLOUD_SQL_INSTANCE=timerally-db
CLOUD_SQL_DB=timerally
CLOUD_SQL_USER=timerally_app
BUCKET_NAME=timerally-prod-assets
SECRET_PREFIX=timerally

PUBLIC_WEB_URL=https://app.timerally.id
PUBLIC_API_URL=https://api.timerally.id
API_CORS_ORIGINS=https://app.timerally.id
VITE_API_BASE_URL=https://api.timerally.id
VITE_ROUTING_PUBLIC_BASE=https://api.timerally.id
VITE_PMTILES_URL=https://tiles.timerally.id/maps/bali.pmtiles

# Cloud Run API writes exports directly to Cloud Storage when using gs://.
EXPORTS_ROOT=gs://timerally-prod-assets/exports
GCS_BUCKET_NAME=timerally-prod-assets
GCS_EXPORTS_PREFIX=exports
GCS_PHOTOS_PREFIX=photos
KNOWLEDGE_ROOT=/app/data/curated

# Routing gateway on Cloud Run calls OSRM/Valhalla exposed by routing VM proxy.
ROUTING_GATEWAY_URL=https://routing-gateway.timerally.id
ROUTING_DEFAULT_PROVIDER=auto
ROUTING_PROVIDER_PRIMARY=osrm
ROUTING_PROVIDER_FALLBACK=valhalla
ROUTING_PROVIDER_STANDBY=graphhopper
ROUTING_ALLOW_MOCK_FALLBACK=false
OSRM_URL=https://routing.timerally.id/osrm
VALHALLA_URL=https://routing.timerally.id/valhalla
GRAPHHOPPER_URL=https://routing.timerally.id/graphhopper
TILESERVER_URL=https://tiles.timerally.id

# Secrets loaded by infra/gcp/secrets_load.sh.
DATABASE_URL=postgresql://timerally_app:REPLACE_ME@127.0.0.1:5432/timerally
GOOGLE_ENABLED=false
GOOGLE_MAPS_API_KEY=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
