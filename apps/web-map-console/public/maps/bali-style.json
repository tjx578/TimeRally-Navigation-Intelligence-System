{
  "version": 8,
  "name": "Time Rally Bali Debug",
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "bali": {
      "type": "vector",
      "url": "pmtiles://https://storage.googleapis.com/timerally-bali-maps/maps/bali.pmtiles"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#eef2e6"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "bali",
      "source-layer": "water",
      "paint": {
        "fill-color": "#9fd3ff"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "bali",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#d8e8c8",
        "fill-opacity": 0.45
      }
    },
    {
      "id": "transportation-casing",
      "type": "line",
      "source": "bali",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 2, 9, 4, 12, 8, 16, 16]
      }
    },
    {
      "id": "transportation-main",
      "type": "line",
      "source": "bali",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#111111",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1, 9, 2, 12, 5, 16, 10]
      }
    },
    {
      "id": "transportation-name",
      "type": "symbol",
      "source": "bali",
      "source-layer": "transportation_name",
      "minzoom": 11,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Open Sans Semibold"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#000000",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "places",
      "type": "symbol",
      "source": "bali",
      "source-layer": "place",
      "minzoom": 6,
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Open Sans Semibold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 7, 12, 12, 16]
      },
      "paint": {
        "text-color": "#cc0000",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    },
    {
      "id": "poi",
      "type": "symbol",
      "source": "bali",
      "source-layer": "poi",
      "minzoom": 13,
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Open Sans Semibold"],
        "text-size": 11
      },
      "paint": {
        "text-color": "#0044cc",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    }
  ]
}
