## Hanya nilai PUBLIC yang boleh ada di sini.
## Supabase service-role / SSH key / signing secret jangan pernah masuk file ini.

# Backend API (kosongkan untuk same-origin Cloud Run / nginx reverse proxy).
VITE_API_BASE_URL=

# Supabase (kalau pakai Supabase; tidak wajib untuk path GCP-only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Basemap MapLibre.
#  - Pakai TileServer GL: http://<edge-ip>:8080/styles/basic/style.json
#  - Pakai MapTiler: https://api.maptiler.com/maps/streets/style.json?key=<KEY>
#  - Biarkan kosong di dev: console otomatis pakai https://demotiles.maplibre.org/style.json
VITE_MAP_STYLE_URL=

# Center awal map (default: tengah Bali).
VITE_MAP_CENTER_LNG=115.1889
VITE_MAP_CENTER_LAT=-8.4095
VITE_MAP_ZOOM=9

# PMTiles single-file offline (opsional). Kalau diset, console akan HEAD-check
# kemudian render style PMTiles inline.
VITE_PMTILES_URL=
VITE_PMTILES_READY=

# Routing.
VITE_ROUTING_PUBLIC_BASE=
VITE_OFFLINE_MODE=false

# Observability.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
