APP_ENV=production
BASE_DOMAIN=time-rally.example

# Managed Supabase data plane
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_DB_URL=postgresql://postgres:replace_me@db.project-ref.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:replace_me@db.project-ref.supabase.co:5432/postgres

# API and browser
API_CORS_ORIGINS=https://app.time-rally.example
VITE_API_BASE_URL=https://api.time-rally.example
VITE_SUPABASE_URL=https://project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace_me
VITE_PMTILES_URL=https://tiles.time-rally.example/basemap.pmtiles

# Routing provider order: primary -> fallback -> standby -> mock
ROUTING_DEFAULT_PROVIDER=osrm
ROUTING_PROVIDER_PRIMARY=osrm
ROUTING_PROVIDER_FALLBACK=valhalla
ROUTING_PROVIDER_STANDBY=graphhopper
ROUTING_ALLOW_MOCK_FALLBACK=false
ROUTING_GATEWAY_URL=http://routing-gateway:8010
OSRM_URL=http://osrm:5000
VALHALLA_URL=http://valhalla:8002
GRAPHHOPPER_URL=http://graphhopper:8989
GOOGLE_ENABLED=false
GOOGLE_MAPS_API_KEY=

# Data/runtime roots
EXPORTS_ROOT=/app/services/api/exports
KNOWLEDGE_ROOT=/app/data/curated
OSRM_DATA_FILE=/data/osrm/region.osrm
VALHALLA_TILE_URLS=/data/osm/region.osm.pbf

# Backup scripts
BACKUP_ROOT=/opt/time-rally/backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
STORAGE_BACKUP_BUCKET=
